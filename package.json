{
  "name": "@vvi/check-version",
  "version": "1.1.3",
  "type": "module",
  "private": true,
  "scripts": {
    "b": "rollup --config rollup.config.js",
    "build": "jja cls rm dist && pnpm run b && pnpm run clean:package",
    "clean:package": "node scripts/clean-package-json.js",
    "diff": "jja pkg --diff=淘宝",
    "prepublishOnly": "pjj",
    "push": "gvv",
    "push:version": "gvv",
    "test": "jja rm .eg && rollup --config rollup.config.eg.js && node .eg/index.js",
    "vjj": "vjj",
    "lint": "jja cls && eslint . --fix",
    "beautify": "jja cls && prettier . --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.3",
    "@vvi/check-version": "^1.1.2",
    "@vvi/rollup-external": "^1.2.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "gvv": "^1.1.1",
    "jja": "^2.5.5",
    "pjj": "^1.0.8",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vjj": "^1.1.0"
  },
  "dependencies": {
    "@vvi/command": "^4.1.0",
    "@vvi/is": "^2.0.8",
    "@vvi/node": "^5.2.0",
    "@vvi/utils": "^2.1.2"
